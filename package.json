{
  "name": "@nauverse/react-aurora-background",
  "version": "2.0.0",
  "description": "A lightweight, GPU-friendly aurora background for React: one tiny WebGL shader, rendered at low resolution, paused when off-screen, with a CSS fallback.",
  "author": "Al | @naucode <al@nauverse.com> (https://nauverse.com)",
  "license": "MIT",
  "homepage": "https://thenaubit.github.io/react-aurora-background/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheNaubit/react-aurora-background.git"
  },
  "bugs": {
    "url": "https://github.com/TheNaubit/react-aurora-background/issues"
  },
  "keywords": [
    "react",
    "aurora",
    "background",
    "gradient",
    "mesh-gradient",
    "webgl",
    "animated-background"
  ],
  "type": "module",
  "main": "./dist/react-aurora-background.cjs",
  "module": "./dist/react-aurora-background.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-aurora-background.js",
      "require": "./dist/react-aurora-background.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.14.0 || >=24.10.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "dev": "vite --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@nauverse/color-to-hsla": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "conventional-commits-filter": "6.0.1",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
